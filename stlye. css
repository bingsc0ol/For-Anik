*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:linear-gradient(135deg,#ffb6c1,#ffc0cb,#ffe4ec);
    overflow-x:hidden;
    color:#333;
}

/* Love Animation */

body::before{
    content:"❤ ❤ ❤ ❤ ❤ ❤ ❤ ❤";
    position:fixed;
    font-size:35px;
    left:-20px;
    top:-20px;
    width:120%;
    height:120%;
    opacity:.08;
    transform:rotate(-20deg);
    pointer-events:none;
}

.container{
    width:90%;
    max-width:900px;
    margin:auto;
    padding:30px 0;
}

.card{
    background:white;
    border-radius:30px;
    padding:40px 25px;
    box-shadow:0 15px 40px rgba(0,0,0,.15);
    text-align:center;
    margin-bottom:40px;
}

h1{
    color:#e91e63;
    font-size:42px;
    margin-bottom:10px;
}

h2{
    color:#e91e63;
    margin-bottom:20px;
}

p{
    font-size:18px;
    line-height:1.8;
}

button{
    margin-top:25px;
    padding:15px 45px;
    border:none;
    border-radius:50px;
    background:#e91e63;
    color:white;
    font-size:18px;
    cursor:pointer;
    transition:.3s;
}

button:hover{
    transform:scale(1.08);
    background:#ff4081;
}

#letter{
    display:none;
    animation:fade .8s;
}

@keyframes fade{
    from{
        opacity:0;
        transform:translateY(30px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

/* GALERI FOTO */

.gallery{
    display:grid;
    grid-template-columns:1fr;
    gap:30px;
    width:90%;
    max-width:700px;
    margin:40px auto;
}

.gallery img{
    width:100%;
    display:block;
    border-radius:25px;
    object-fit:cover;
    box-shadow:0 15px 35px rgba(0,0,0,.25);
    transition:.4s;
}

.gallery img:hover{
    transform:scale(1.03);
}

/* Footer */

footer{
    text-align:center;
    padding:40px;
    color:white;
    font-size:18px;
}

/* Mobile */

@media(min-width:768px){

.gallery{
grid-template-columns:repeat(2,1fr);
}

.gallery img:nth-child(3){
grid-column:span 2;
}

}

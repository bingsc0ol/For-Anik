<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Happy Birthday Anik ❤️</title>

<link rel="stylesheet" href="style.css">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{

background:linear-gradient(135deg,#ff9ecf,#ffd8ea);

overflow-x:hidden;

}

.hero{

min-height:100vh;

display:flex;

justify-content:center;

align-items:center;

padding:30px;

}

.card{

width:100%;

max-width:800px;

background:rgba(255,255,255,.25);

backdrop-filter:blur(20px);

border-radius:25px;

padding:35px;

text-align:center;

box-shadow:0 15px 40px rgba(0,0,0,.2);

}

.card h3{

font-size:20px;

margin-bottom:10px;

}

.card h1{

font-size:55px;

color:#e91e63;

margin-bottom:20px;

}

.card p{

font-size:18px;

color:#444;

line-height:1.7;

}

button{

margin-top:30px;

padding:15px 35px;

border:none;

border-radius:40px;

font-size:20px;

background:#e91e63;

color:white;

cursor:pointer;

}

.gallery{

padding:50px 20px;

display:grid;

grid-template-columns:repeat(auto-fit,minmax(250px,1fr));

gap:20px;

max-width:1000px;

margin:auto;

}

.gallery img{

width:100%;

border-radius:20px;

box-shadow:0 10px 20px rgba(0,0,0,.2);

transition:.3s;

}

.gallery img:hover{

transform:scale(1.05);

}

#letter{

display:none;

max-width:800px;

margin:40px auto;

background:white;

padding:35px;

border-radius:20px;

box-shadow:0 10px 30px rgba(0,0,0,.2);

line-height:2;

font-size:18px;

}

footer{

text-align:center;

padding:40px;

font-size:18px;

color:#555;

}

</style>

</head>

<body>

<section class="hero">

<div class="card">

<h3>🎁 Sebuah Hadiah Untuk</h3>

<h1>Anik ❤️</h1>

<p>

Selamat ulang tahun untuk perempuan yang selalu membuat hariku lebih indah.

Semoga semua impianmu menjadi kenyataan dan kebahagiaan selalu menyertaimu.

</p>

<button onclick="openLetter()">

💌 Buka Surat

</button>

</div>

</section>

<div id="letter">

<h2 style="text-align:center;color:#e91e63">

Untukmu ❤️

</h2>

<br>

<p id="typing"></p>

</div>

<section class="gallery">

<img src="Foto1.jpg">

<img src="Foto2.jpg">

<img src="Foto3.jpg">

</section>

<footer>

❤️ Dibuat dengan cinta khusus untuk Anik ❤️

</footer>

<script>

function openLetter(){

document.getElementById("letter").style.display="block";

document.getElementById("letter").scrollIntoView({behavior:"smooth"});

const txt=`Selamat ulang tahun Anik ❤️

Terima kasih sudah hadir dalam hidupku.

Semoga setiap langkahmu selalu dipenuhi kebahagiaan.

Aku berharap kita bisa terus membuat kenangan indah bersama.

Terima kasih karena selalu menjadi alasan aku tersenyum.

I Love You ❤️`;

let i=0;

const target=document.getElementById("typing");

target.innerHTML="";

function type(){

if(i<txt.length){

target.innerHTML+=txt.charAt(i);

i++;

setTimeout(type,35);

}

}

type();
// Animasi hati

function createHeart(){

const heart=document.createElement("div");

heart.innerHTML="❤️";

heart.style.position="fixed";

heart.style.left=Math.random()*100+"vw";

heart.style.top="-30px";

heart.style.fontSize=(20+Math.random()*25)+"px";

heart.style.pointerEvents="none";

heart.style.zIndex="9999";

heart.style.transition="transform 7s linear, opacity 7s";

document.body.appendChild(heart);

setTimeout(()=>{

heart.style.transform="translateY(110vh) rotate(360deg)";

heart.style.opacity="0";

},50);

setTimeout(()=>{

heart.remove();

},7000);

}

setInterval(createHeart,400);

</script>

</body>

</html>
}
